<Window x:Class="Rafferty.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AppName}" Width="460" Height="780" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#090B10">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="50" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Background="#090B10"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="20,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="8" Background="#211E3A" BorderBrush="#554AAC" BorderThickness="1"><TextBlock Text="R" FontWeight="SemiBold" Foreground="#A69DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{DynamicResource BrandName}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Style="{StaticResource TitleButton}" Width="38" Height="32" Click="MinimizeButton_Click"/><Button Content="×" Style="{StaticResource CloseButton}" Width="38" Height="32" FontSize="17" Click="CloseButton_Click"/></StackPanel></Grid>
    <Grid Grid.Row="1" Margin="24,6,24,18" ClipToBounds="True">
      <Grid x:Name="DashboardPage" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock x:Name="StatusTitle" Text="{DynamicResource ReadyTitle}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="StatusSubtitle" Text="{DynamicResource ReadySubtitle}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,8"/></StackPanel>
        <StackPanel Grid.Row="1"><Button x:Name="PowerButton" Content="{DynamicResource Enable}" Style="{StaticResource PowerButton}" Click="PowerButton_Click"/><TextBlock x:Name="ProtectionText" Text="{DynamicResource NotActive}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,8"/></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,9"><StackPanel>
          <Grid Height="37"><Ellipse x:Name="YoutubeDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="YouTube" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="YoutubeState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="YoutubeLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
          <Border Height="1" Background="#202632"/><Grid Height="37"><Ellipse x:Name="DiscordDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="Discord" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="DiscordState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="DiscordLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
          <Border Height="1" Background="#202632"/><Grid Height="37"><Ellipse x:Name="VoiceDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="{DynamicResource Voice}" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="VoiceState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="VoiceLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
          <Button x:Name="LatencyButton" Content="{DynamicResource TestLatency}" Margin="0,8,0,0" Click="LatencyButton_Click"/><TextBlock x:Name="LastTestText" Text="{DynamicResource NotTested}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel></Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,11" Margin="0,10,0,0"><Grid><StackPanel><TextBlock Text="{DynamicResource AutoMode}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{DynamicResource AdaptiveProtection}" FontSize="12" Margin="0,3,0,0"/><TextBlock x:Name="StrategyText" Text="{DynamicResource AutoConfiguration}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/></StackPanel><Button Content="{DynamicResource Settings}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Click="SettingsButton_Click"/></Grid></Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0"><StackPanel><StackPanel><TextBlock Text="{DynamicResource Advanced}" FontWeight="SemiBold"/><TextBlock x:Name="RuntimeDetail" Text="{DynamicResource EngineStopped}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" Margin="0,3,0,0"/></StackPanel><UniformGrid Columns="2" Rows="2" Margin="0,8,0,0"><Button Content="{DynamicResource Diagnostics}" Margin="0,0,4,4" Padding="6" Click="DiagnosticsButton_Click"/><Button Content="{DynamicResource ParityTest}" Margin="4,0,0,4" Padding="6" Click="ParityTestButton_Click"/><Button Content="{DynamicResource ExportDiagnostics}" Margin="0,4,4,0" Padding="6" Click="ExportDiagnosticsButton_Click"/><Button Content="{DynamicResource Logs}" Margin="4,4,0,0" Padding="6" Click="LogsButton_Click"/></UniformGrid></StackPanel></Border>
        <StackPanel Grid.Row="5" VerticalAlignment="Bottom"><ProgressBar x:Name="ActivityProgress" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="ActivityText" Text="{DynamicResource Ready}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
      </Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TranslateTransform X="24"/></Grid.RenderTransform><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="44"><Button Content="←" Width="40" Padding="0" HorizontalAlignment="Left" Click="BackButton_Click"/><TextBlock Text="{DynamicResource Settings}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <TextBlock Grid.Row="1" Text="{DynamicResource General}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,7,0,5"/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,3"><StackPanel>
          <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Language}"/><TextBlock Text="{DynamicResource LanguageDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel><ComboBox x:Name="LanguageSelector" Style="{StaticResource DarkComboBox}" Width="105" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="LanguageSelector_SelectionChanged"><ComboBoxItem Tag="ru-RU" Content="{DynamicResource Russian}"/><ComboBoxItem Tag="en-US" Content="{DynamicResource English}"/></ComboBox></Grid><Border Height="1" Background="#202632"/>
          <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StartWithWindows}"/><TextBlock Text="{DynamicResource StartWithWindowsDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingToggle_Click"/></Grid><Border Height="1" Background="#202632"/>
          <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StartEnabled}"/><TextBlock Text="{DynamicResource StartEnabledDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="StartEnabledToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingToggle_Click"/></Grid><Border Height="1" Background="#202632"/>
          <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource AutoOptimization}"/><TextBlock Text="{DynamicResource AutoOptimizationDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="AutoOptimizationToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingToggle_Click"/></Grid><Border Height="1" Background="#202632"/>
          <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Notifications}"/><TextBlock Text="{DynamicResource NotificationsDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel><ToggleButton x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingToggle_Click"/></Grid>
        </StackPanel></Border>
        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource Engine}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{DynamicResource AutoStrategy}" Margin="0,4,0,0"/><TextBlock x:Name="SettingsProfileText" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,6"/><Button Content="{DynamicResource Reoptimize}" Padding="8,6" Click="ReoptimizeButton_Click"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Application}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{DynamicResource Version}" Margin="0,4,0,0"/><TextBlock Text="{DynamicResource AppDescription}" TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,6"/><Button Content="{DynamicResource About}" Padding="8,6" Click="AboutButton_Click"/></StackPanel></Border></Grid>
        <StackPanel Grid.Row="4" VerticalAlignment="Bottom"><Button Content="{DynamicResource OpenAdvanced}" Margin="0,8,0,0" Click="OpenAdvancedButton_Click"/><TextBlock Text="{DynamicResource LocalSettings}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,6,0,4"/></StackPanel>
      </Grid>
    </Grid>
  </Grid></Border>
</Window>
