<Window x:Class="Rafferty.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Width="460" Height="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#090B10">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="50" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#252B38" BorderThickness="1" CornerRadius="14" Background="#090B10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="20,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Background="#211E3A" BorderBrush="#554AAC" BorderThickness="1">
            <TextBlock Text="R" FontWeight="SemiBold" Foreground="#A69DFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{DynamicResource BrandName}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="—" Style="{StaticResource TitleButton}" Width="38" Height="32" Click="MinimizeButton_Click"/>
          <Button Content="×" Style="{StaticResource CloseButton}" Width="38" Height="32" FontSize="17" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="24,6,24,18" ClipToBounds="True">
        <Grid x:Name="DashboardPage" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock x:Name="StatusTitle" Text="{DynamicResource ReadyTitle}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusSubtitle" Text="{DynamicResource ReadySubtitle}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,8"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <Button x:Name="PowerButton" Content="{DynamicResource Enable}" Style="{StaticResource PowerButton}" Click="PowerButton_Click"/>
            <TextBlock x:Name="ProtectionText" Text="{DynamicResource NotActive}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
          </StackPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,9">
            <StackPanel>
              <Grid Height="37"><Ellipse x:Name="YoutubeDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="YouTube" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="YoutubeState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="YoutubeLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
              <Border Height="1" Background="#202632"/>
              <Grid Height="37"><Ellipse x:Name="DiscordDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="Discord" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="DiscordState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="DiscordLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
              <Border Height="1" Background="#202632"/>
              <Grid Height="37"><Ellipse x:Name="VoiceDot" Width="8" Height="8" Fill="#4B5060" HorizontalAlignment="Left"/><TextBlock Text="{DynamicResource Voice}" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="VoiceState" Text="{DynamicResource Waiting}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/><TextBlock x:Name="VoiceLatency" Text="—" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
              <Button x:Name="LatencyButton" Content="{DynamicResource TestLatency}" Margin="0,8,0,0" Click="LatencyButton_Click"/>
              <TextBlock x:Name="LastTestText" Text="{DynamicResource NotTested}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,11" Margin="0,10,0,0">
            <Grid>
              <StackPanel>
                <TextBlock Text="{DynamicResource Strategy}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock x:Name="StrategyText" Text="general" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
                <TextBlock x:Name="ModeText" Text="{DynamicResource AutomaticMode}" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Content="{DynamicResource Settings}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Click="SettingsButton_Click"/>
            </Grid>
          </Border>
          <UniformGrid Grid.Row="4" Columns="2" Margin="0,10,0,0">
            <Button Content="{DynamicResource Diagnostics}" Margin="0,0,5,0" Click="DiagnosticsButton_Click"/>
            <Button Content="{DynamicResource Logs}" Margin="5,0,0,0" Click="LogsButton_Click"/>
          </UniformGrid>
          <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
            <ProgressBar x:Name="ActivityProgress" Margin="0,10,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="ActivityText" Text="{DynamicResource Ready}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="SettingsPage" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><TranslateTransform X="24"/></Grid.RenderTransform>
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Button Content="←" Width="40" Padding="0" HorizontalAlignment="Left" Click="BackButton_Click"/><TextBlock Text="{DynamicResource Settings}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,6,8,8">
              <TextBlock Text="{DynamicResource General}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,5"/>
              <Border Style="{StaticResource Card}" Padding="16,3"><StackPanel>
                <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Language}"/><TextBlock Text="{DynamicResource LanguageDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><ComboBox x:Name="LanguageSelector" Style="{StaticResource DarkComboBox}" Width="105" Height="32" HorizontalAlignment="Right" SelectionChanged="LanguageSelector_SelectionChanged"><ComboBoxItem Tag="ru-RU" Content="{DynamicResource Russian}"/><ComboBoxItem Tag="en-US" Content="{DynamicResource English}"/></ComboBox></Grid>
                <Border Height="1" Background="#202632"/>
                <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StartWithWindows}"/><TextBlock Text="{DynamicResource StartWithWindowsDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/></Grid>
                <Border Height="1" Background="#202632"/>
                <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource MinimizeToTray}"/><TextBlock Text="{DynamicResource MinimizeToTrayDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><ToggleButton x:Name="MinimizeToTrayToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/></Grid>
                <Border Height="1" Background="#202632"/>
                <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Notifications}"/><TextBlock Text="{DynamicResource NotificationsDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><ToggleButton x:Name="NotificationsToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/></Grid>
              </StackPanel></Border>

              <TextBlock Text="{DynamicResource Bypass}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,5"/>
              <Border Style="{StaticResource Card}" Padding="16,10"><StackPanel>
                <Grid Height="38"><TextBlock Text="{DynamicResource Mode}" VerticalAlignment="Center"/><ComboBox x:Name="ModeSelector" Style="{StaticResource DarkComboBox}" Width="195" Height="32" HorizontalAlignment="Right" SelectionChanged="ModeSelector_SelectionChanged"><ComboBoxItem Tag="auto" Content="{DynamicResource AutomaticMode}"/><ComboBoxItem Tag="manual" Content="{DynamicResource ManualMode}"/></ComboBox></Grid>
                <StackPanel x:Name="ManualStrategyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                  <TextBlock Text="{DynamicResource Strategy}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                  <Grid><ComboBox x:Name="StrategySelector" Style="{StaticResource DarkComboBox}" Height="34" Margin="0,0,105,0"/><Button x:Name="ApplyStrategyButton" Content="{DynamicResource Apply}" Width="95" HorizontalAlignment="Right" Click="ApplyStrategyButton_Click"/></Grid>
                </StackPanel>
                <Border Height="1" Background="#202632" Margin="0,10,0,0"/>
                <Grid Height="48"><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource StartEnabled}"/><TextBlock Text="{DynamicResource StartEnabledDescription}" FontSize="9" Foreground="{StaticResource MutedTextBrush}"/></StackPanel><ToggleButton x:Name="StartEnabledToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="SettingToggle_Click"/></Grid>
              </StackPanel></Border>

              <TextBlock Text="{DynamicResource AutoOptimization}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,5"/>
              <Border Style="{StaticResource Card}" Padding="16,10"><StackPanel>
                <CheckBox x:Name="CheckYouTubeBox" Content="YouTube" Margin="0,3" Click="SettingToggle_Click"/>
                <CheckBox x:Name="CheckDiscordBox" Content="Discord" Margin="0,3" Click="SettingToggle_Click"/>
                <CheckBox x:Name="CheckVoiceBox" Content="{DynamicResource Voice}" Margin="0,3" Click="SettingToggle_Click"/>
                <Button Content="{DynamicResource RunOptimization}" Margin="0,9,0,0" Click="ReoptimizeButton_Click"/>
              </StackPanel></Border>

              <Button Content="{DynamicResource OpenAdvanced}" Margin="0,12,0,0" Click="OpenAdvancedButton_Click"/>
              <Button Content="{DynamicResource About}" Margin="0,8,0,0" Click="AboutButton_Click"/>
              <TextBlock Text="{DynamicResource LocalSettings}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,8,0,4"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="AdvancedPage" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><TranslateTransform X="24"/></Grid.RenderTransform>
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0"><Button Content="←" Width="40" Padding="0" HorizontalAlignment="Left" Click="AdvancedBackButton_Click"/><TextBlock Text="{DynamicResource AdvancedSettings}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,8,8">
            <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{DynamicResource CurrentStrategy}"/><TextBlock Text="Engine" Margin="0,8,0,0"/><TextBlock Text="WinDivert" Margin="0,8,0,0"/><TextBlock Text="PID" Margin="0,8,0,0"/><TextBlock Text="{DynamicResource WorkingDirectory}" Margin="0,8,0,0"/><TextBlock Text="Runtime" Margin="0,8,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="AdvancedStrategyText" Text="—" HorizontalAlignment="Right"/><TextBlock x:Name="AdvancedEngineText" Text="Stopped" Margin="0,8,0,0" HorizontalAlignment="Right"/><TextBlock x:Name="AdvancedDriverText" Text="Not loaded" Margin="0,8,0,0" HorizontalAlignment="Right"/><TextBlock x:Name="AdvancedPidText" Text="—" Margin="0,8,0,0" HorizontalAlignment="Right"/><TextBlock x:Name="AdvancedWorkingDirectoryText" Text="—" Margin="15,8,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="AdvancedRuntimeText" Text="—" Margin="15,8,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
            </Grid></Border>
            <TextBlock Text="Raw winws command" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,5"/>
            <TextBox x:Name="CommandLineText" IsReadOnly="True" TextWrapping="Wrap" Height="112" VerticalScrollBarVisibility="Auto" Padding="10" FontFamily="Consolas" FontSize="10"/>
            <Button Content="{DynamicResource CopyCommand}" Margin="0,8,0,0" Click="CopyCommandButton_Click"/>
            <TextBlock Text="{DynamicResource RuntimeConfiguration}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,0,5"/>
            <Border Style="{StaticResource Card}" Padding="14"><StackPanel>
              <Grid Height="30"><TextBlock Text="{DynamicResource CustomDomains}" VerticalAlignment="Center"/><Button Content="{DynamicResource Edit}" Width="92" HorizontalAlignment="Right" Click="EditCustomDomainsButton_Click"/></Grid>
              <Grid Height="38"><TextBlock Text="{DynamicResource ExcludedDomains}" VerticalAlignment="Center"/><Button Content="{DynamicResource Edit}" Width="92" HorizontalAlignment="Right" Click="EditExcludedDomainsButton_Click"/></Grid>
              <Grid Height="28"><TextBlock Text="{DynamicResource IpSetMode}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource ReferenceIpSet}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
              <Grid Height="28"><TextBlock Text="{DynamicResource GameFilter}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource GameFilterDisabled}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </StackPanel></Border>
            <UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="{DynamicResource Diagnostics}" Margin="0,0,5,5" Click="DiagnosticsButton_Click"/><Button Content="{DynamicResource ExportDiagnostics}" Margin="5,0,0,5" Click="ExportDiagnosticsButton_Click"/><Button Content="{DynamicResource Logs}" Margin="0,5,5,0" Click="LogsButton_Click"/><Button Content="{DynamicResource StrategyList}" Margin="5,5,0,0" Click="StrategyListButton_Click"/></UniformGrid>
            <UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="{DynamicResource ReloadStrategies}" Margin="0,0,5,0" Click="ReloadStrategiesButton_Click"/><Button Content="{DynamicResource ImportStrategy}" Margin="5,0,0,0" Click="ImportStrategyButton_Click"/></UniformGrid>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
