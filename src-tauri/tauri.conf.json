{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rafferty",
  "version": "0.1.0",
  "identifier": "net.rafferty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rafferty",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#080b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A lightweight Windows network utility",
    "longDescription": "Tests network reachability and controls a separately installed compatible packet-processing engine.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
